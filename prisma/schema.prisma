// docs/data-model.md 를 그대로 반영한 스키마.
// CHECK 제약과 부분 유니크 인덱스처럼 Prisma DSL이 표현하지 못하는 항목은
// prisma/migrations의 생성된 SQL을 직접 보강한다 (docs/guidelines/stack/typescript.md 참조).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobMajor {
  DEV       @map("개발")
  DESIGN    @map("디자인")
  MARKETING @map("마케팅")
  PLANNING  @map("기획")
  SALES     @map("영업")
  HR        @map("HR")

  @@map("job_major")
}

enum JobMinor {
  FRONTEND       @map("프론트엔드")
  BACKEND        @map("백엔드")
  FULLSTACK      @map("풀스택")
  MOBILE         @map("모바일")
  DATA_AI        @map("데이터·AI")
  DEVOPS_INFRA   @map("DevOps·인프라")
  UX_UI          @map("UX·UI")
  GRAPHIC_BRAND  @map("그래픽·브랜딩")
  PRODUCT_DESIGN @map("프로덕트 디자인")
  PERFORMANCE    @map("퍼포먼스")
  BRAND_CONTENT  @map("브랜드·콘텐츠")
  GROWTH         @map("그로스")
  PRODUCT_PLAN   @map("프로덕트 기획")
  SERVICE_PLAN   @map("서비스 기획")
  SALES_MINOR    @map("영업")
  BIZ_DEV        @map("비즈니스 개발")
  RECRUITING     @map("채용")
  PEOPLE_CULTURE @map("인사·조직문화")

  @@map("job_minor")
}

enum ExperienceBand {
  ENTRY      @map("신입")
  YEARS_1_3  @map("1~3년")
  YEARS_4_7  @map("4~7년")
  YEARS_8_UP @map("8년+")

  @@map("experience_band")
}

enum SubmissionLane {
  general
  priority

  @@map("submission_lane")
}

enum SubmissionStatus {
  open
  closed

  @@map("submission_status")
}

enum ClaimStatus {
  claimed
  reviewed
  abandoned

  @@map("claim_status")
}

enum CreditEventType {
  signup_bonus
  submission_debit
  review_credit

  @@map("credit_event_type")
}

enum PriorityPassStatus {
  active
  completed
  cancelled

  @@map("priority_pass_status")
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique
  passwordHash   String         @map("password_hash")
  jobMajor       JobMajor       @map("job_major")
  jobMinor       JobMinor       @map("job_minor")
  experienceBand ExperienceBand @map("experience_band")
  creditBalance  Int            @default(5) @map("credit_balance")
  trustScore     Decimal        @default(0.00) @map("trust_score") @db.Decimal(5, 2)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  submissions           Submission[]
  queueClaims           QueueClaim[]
  reviews               Review[]
  trustChecklistAnswers TrustChecklistResponse[]
  creditLedgerEntries   CreditLedgerEntry[]
  priorityPasses        PriorityPass[]

  @@map("users")
}

model Submission {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  title          String
  bodyText       String            @map("body_text")
  jobMajor       JobMajor          @map("job_major")
  jobMinor       JobMinor          @map("job_minor")
  experienceBand ExperienceBand    @map("experience_band")
  lane           SubmissionLane    @default(general)
  reviewerCount  Int               @default(0) @map("reviewer_count")
  status         SubmissionStatus  @default(open)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  user           User            @relation(fields: [userId], references: [id])
  queueClaims    QueueClaim[]
  reviews        Review[]
  priorityPass   PriorityPass?
  trustChecklistAnswers TrustChecklistResponse[]

  @@index([jobMajor, jobMinor, experienceBand, createdAt], map: "idx_submissions_queue")
  @@map("submissions")
}

model QueueClaim {
  id            String      @id @default(uuid()) @db.Uuid
  submissionId  String      @map("submission_id") @db.Uuid
  reviewerId    String      @map("reviewer_id") @db.Uuid
  status        ClaimStatus @default(claimed)
  claimedAt     DateTime    @default(now()) @map("claimed_at") @db.Timestamptz
  reviewedAt    DateTime?   @map("reviewed_at") @db.Timestamptz

  submission Submission @relation(fields: [submissionId], references: [id])
  reviewer   User       @relation(fields: [reviewerId], references: [id])
  review     Review?

  @@unique([submissionId, reviewerId])
  @@index([submissionId], map: "idx_queue_claims_submission")
  @@map("queue_claims")
}

model Review {
  id                String   @id @default(uuid()) @db.Uuid
  queueClaimId      String   @unique @map("queue_claim_id") @db.Uuid
  submissionId      String   @map("submission_id") @db.Uuid
  reviewerId        String   @map("reviewer_id") @db.Uuid
  scoreRelevance    Int      @map("score_relevance") @db.SmallInt
  scoreLogic        Int      @map("score_logic") @db.SmallInt
  scoreSpecificity  Int      @map("score_specificity") @db.SmallInt
  scoreReadability  Int      @map("score_readability") @db.SmallInt
  comment           String
  submittedAt       DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  queueClaim             QueueClaim               @relation(fields: [queueClaimId], references: [id])
  submission             Submission               @relation(fields: [submissionId], references: [id])
  reviewer               User                     @relation(fields: [reviewerId], references: [id])
  trustChecklistResponse TrustChecklistResponse?

  @@map("reviews")
}

model TrustChecklistResponse {
  id                      String   @id @default(uuid()) @db.Uuid
  reviewId                String   @unique @map("review_id") @db.Uuid
  submissionId            String   @map("submission_id") @db.Uuid
  submitterId             String   @map("submitter_id") @db.Uuid
  usedSpecifics           Boolean  @map("used_specifics")
  newPerspective          Boolean  @map("new_perspective")
  actionableAlternatives  Boolean  @map("actionable_alternatives")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz

  review     Review     @relation(fields: [reviewId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])
  submitter  User       @relation(fields: [submitterId], references: [id])

  @@map("trust_checklist_responses")
}

model CreditLedgerEntry {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  delta     Int
  eventType CreditEventType @map("event_type")
  refId     String?         @map("ref_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)], map: "idx_credit_ledger_user")
  @@map("credit_ledger_entries")
}

model PriorityPass {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  submissionId String               @unique @map("submission_id") @db.Uuid
  status       PriorityPassStatus   @default(active)
  expiresAt    DateTime             @map("expires_at") @db.Timestamptz
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz

  user       User       @relation(fields: [userId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])

  @@map("priority_passes")
}
